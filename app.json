{
  "expo": {
    "name": "Dots",
    "slug": "dots",
    "owner": "chrisinesons-team",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cjineson.dots"
    },
    "android": {
      "package": "com.cjineson.dots",
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "expo-sharing",
      "expo-font",
      "@react-native-community/datetimepicker",
      ["expo-location", { "locationWhenInUsePermission": "Dots uses your location to fill in a setlist venue." }]
    ],
    "extra": {
      "eas": {
        "projectId": "9c7ffafd-f82c-46be-9759-325330234554"
      }
    }
  }
}
